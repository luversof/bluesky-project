<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>net.luversof</groupId>
		<artifactId>bluesky-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>bluesky-api</artifactId>
	<packaging>pom</packaging>
	<modules>
		<module>bluesky-api-bookkeeping</module>
		<module>bluesky-api-user</module>
		<module>bluesky-api-blog</module>
		<module>bluesky-api-board</module>
		<module>bluesky-api-stock</module>
		<module>bluesky-api-poe</module>
		<module>bluesky-api-common</module>
	</modules>
	<properties>
		<therapi-runtime-javadoc.version>0.15.0</therapi-runtime-javadoc.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>net.luversof</groupId>
			<artifactId>bluesky-core</artifactId>
		</dependency>
		<dependency>
			<groupId>net.luversof</groupId>
			<artifactId>bluesky-test</artifactId>
		</dependency>
		<!-- Javadoc of controllers and DTOs becomes the springdoc API description -->
		<dependency>
			<groupId>com.github.therapi</groupId>
			<artifactId>therapi-runtime-javadoc</artifactId>
			<version>${therapi-runtime-javadoc.version}</version>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths combine.children="append">
						<path>
							<groupId>com.github.therapi</groupId>
							<artifactId>therapi-runtime-javadoc-scribe</artifactId>
							<version>${therapi-runtime-javadoc.version}</version>
						</path>
					</annotationProcessorPaths>
					<compilerArgs combine.children="append">
						<arg>-Ajavadoc.packages=net.luversof.api</arg>
					</compilerArgs>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>