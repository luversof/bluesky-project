<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>net.luversof</groupId>
		<artifactId>bluesky-api</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>bluesky-api-poe</artifactId>
	<dependencies>
		<dependency>
			<groupId>net.luversof</groupId>
			<artifactId>bluesky-api-common</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		<!-- (s) spring-boot -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- (e) spring-boot -->

		<!-- (s) springdoc-openapi -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>
		<!-- (e) springdoc-openapi -->

		<!-- (s) spring-boot-admin -->
		<dependency>
			<groupId>de.codecentric</groupId>
			<artifactId>spring-boot-admin-starter-client</artifactId>
		</dependency>
		<!-- (e) spring-boot-admin -->

		<dependency>
			<groupId>org.hibernate.validator</groupId>
			<artifactId>hibernate-validator</artifactId>
		</dependency>

	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>com.google.cloud.tools</groupId>
				<artifactId>jib-maven-plugin</artifactId>
				<configuration>
					<!-- base 이미지는 공유 설정(temurin-alpine) 그대로. LuaJIT 등 엔진 런타임은
					     bluesky-argocd-applications 의 initContainer 가 pod 기동 시 준비한다(이미지 관리 없음).
					     엔진 스크립트(tools/poe-pob · poe2-pob)와 데이터 갱신 스크립트를 컨테이너 cwd(/usr/local/app) 에 baking. -->
					<extraDirectories>
						<paths>
							<path>
								<from>tools/poe-pob</from>
								<into>/usr/local/app/tools/poe-pob</into>
							</path>
							<path>
								<from>tools/poe2-pob</from>
								<into>/usr/local/app/tools/poe2-pob</into>
							</path>
							<!-- 데이터 갱신 파이프라인 — 파드 안에서 돌린다(node · ImageMagick 등은 values.yaml 의 기동 명령이 설치).
							     node_modules 는 git 밖이라 빼고, 파이프라인이 처음 돌 때 npm install 로 받는다. -->
							<path>
								<from>tools/poe-extract</from>
								<into>/usr/local/app/tools/poe-extract</into>
								<excludes>node_modules/**</excludes>
							</path>
							<path>
								<from>tools/poe2-extract</from>
								<into>/usr/local/app/tools/poe2-extract</into>
								<excludes>node_modules/**</excludes>
							</path>
						</paths>
					</extraDirectories>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
