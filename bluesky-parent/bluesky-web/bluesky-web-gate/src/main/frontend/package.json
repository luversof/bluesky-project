{
	"name": "frontend",
	"private": true,
	"scripts": {
		"build": "npm-run-all build:ts build:css build:vendor",
		"build:ts": "tsc",
		"build:css": "tailwindcss -i ./main.css -o ../resources/static/main.css",
		"build:vendor": "node copy-vendor.mjs",
		"watch:css": "tailwindcss -i ./main.css -o ../resources/static/main.css --watch",
		"watch:format": "chokidar \"src/**/*.ts\" -c \"prettier --write {path}\"",
		"watch:ts": "tsc --watch",
		"watch": "npm-run-all --parallel --print-label --color watch:css watch:ts"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.16",
		"@tsconfig/recommended": "^1.0.10",
		"chokidar-cli": "^3.0.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.6.2",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@tailwindcss/cli": "^4.0.10",
		"chart.js": "4.5.1",
		"chartjs-plugin-zoom": "2.0.1",
		"dayjs": "1.11.18",
		"easymde": "2.20.0",
		"hammerjs": "2.0.8",
		"htmx-ext-json-enc": "2.0.3",
		"htmx.org": "2.0.10",
		"tailwindcss": "^4.0.10",
		"theme-change": "3.0.4"
	},
	"prettier": {
		"useTabs": true
	}
}
