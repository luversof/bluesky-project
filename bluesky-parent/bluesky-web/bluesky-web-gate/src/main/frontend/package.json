{
	"name": "frontend",
	"private": true,
	"scripts": {
		"build": "tailwindcss -i ./main.css -o ../resources/static/main.css",
		"watch:css": "tailwindcss -i ./main.css -o ../resources/static/main.css --watch",
		"watch:format": "chokidar \"src/**/*.ts\" -c \"prettier --write {path}\"",
		"watch:ts": "tsc --watch",
		"watch": "npm-run-all --parallel --print-label --color watch:css watch:ts"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.16",
		"@tsconfig/recommended": "^1.0.10",
		"chokidar-cli": "^3.0.0",
		"daisyui": "^5.0.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.6.2",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@tailwindcss/cli": "^4.0.10",
		"tailwindcss": "^4.0.10"
	},
	"prettier": {
		"useTabs": true
	}
}