<%-- 라이트 · 다크 전환 단추(js/theme.js). 처음 값은 layout 머리의 짧은 스크립트가 그리기 전에 정한다 --%>
<button type="button" class="icon-btn" data-theme-toggle aria-label="어두운 테마" aria-pressed="false" title="라이트 · 다크 테마 바꾸기">
	<span class="theme-icon-light" aria-hidden="true">☾</span><span class="theme-icon-dark" aria-hidden="true">☀</span>
</button>
